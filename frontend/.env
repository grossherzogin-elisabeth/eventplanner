# This is the base config file, all other config files override values of this file
# for more info see: https://cli.vuejs.org/guide/mode-and-env.html#modes

VITE_DEV_SERVER_HOST=localhost
VITE_DEV_SERVER_PORT=8080
VITE_DEV_SERVER_SERVICE_URL=http://localhost:8081

# i18n
VITE_I18N_LOCALE=de
VITE_I18N_FALLBACK_LOCALE=de
VITE_I18N_LOCALES=de

# feature flags
VITE_USE_INDEXED_DB=true
VITE_ASK_BEFORE_LOGIN=false
VITE_ENABLE_EVENT_POSITIONS_OVERVIEW=false
